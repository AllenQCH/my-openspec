{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSpec Initiative Archive Revision",
  "type": "object",
  "required": ["schemaVersion", "objectType", "initiativeKey", "revision", "archivedAt", "snapshots"],
  "properties": {
    "schemaVersion": {"const": 1},
    "objectType": {"const": "initiative_archive_revision"},
    "revision": {"type": "string", "pattern": "^r[0-9]{3}$"},
    "snapshots": {"type": "array", "minItems": 1}
  }
}
