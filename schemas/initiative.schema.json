{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSpec Shared Initiative",
  "type": "object",
  "required": ["schemaVersion", "objectType", "initiativeKey", "demandId", "demandTitle", "environment", "status", "participatingProjects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "objectType": {"const": "initiative"},
    "environment": {"enum": ["cn", "intl", "shared"]},
    "participatingProjects": {"type": "array", "minItems": 1, "uniqueItems": true}
  }
}
